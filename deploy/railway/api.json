{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "src/**",
      "prisma/**",
      "package.json",
      "package-lock.json",
      "Dockerfile",
      "tsconfig*.json"
    ]
  },
  "deploy": {
    "startCommand": "node --enable-source-maps dist/main.js",
    "healthcheckPath": "/health/ready",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "overlapSeconds": 20,
    "drainingSeconds": 25
  }
}
