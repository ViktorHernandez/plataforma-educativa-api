{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["src/**", "prisma/**", "package.json", "package-lock.json", "Dockerfile", "tsconfig*.json"]
  },
  "deploy": {
    "startCommand": "node --enable-source-maps dist/worker.js",
    "healthcheckPath": "/health/live",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ALWAYS",
    "drainingSeconds": 25
  }
}
