{
  "name": "plataforma-educativa-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/lib-storage": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.0",
    "@fastify/helmet": "13.2.0",
    "@fastify/swagger": "9.9.3",
    "@fastify/swagger-ui": "6.1.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@socket.io/redis-adapter": "8.3.0",
    "@socket.io/redis-emitter": "5.1.0",
    "argon2": "0.45.2",
    "bullmq": "6.5.4",
    "fastify": "5.12.8",
    "fastify-plugin": "6.0.1",
    "fastify-type-provider-zod": "7.0.0",
    "file-type": "22.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.15",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prisma": "7.10.1",
    "prom-client": "15.1.3",
    "qrcode": "1.5.4",
    "rate-limiter-flexible": "11.2.4",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "eslint": "10.14.0",
    "pino-pretty": "13.2.0",
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "mysql2": "^3.24.4"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/main.ts",
    "dev:worker": "node --env-file-if-exists=.env --watch --import tsx src/worker.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/main.js",
    "start:worker": "node --enable-source-maps dist/worker.js",
    "start:local": "node --env-file-if-exists=.env --enable-source-maps dist/main.js",
    "start:local:worker": "node --env-file-if-exists=.env --enable-source-maps dist/worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema --exit-code",
    "db:seed": "node --env-file-if-exists=.env --import tsx src/scripts/seed.ts",
    "db:seed:prod": "node --enable-source-maps dist/scripts/seed.js",
    "demo:seed": "node --env-file-if-exists=.env --import tsx src/scripts/demo.ts seed",
    "demo:reset": "node --env-file-if-exists=.env --import tsx src/scripts/demo.ts reset",
    "demo:remove": "node --env-file-if-exists=.env --import tsx src/scripts/demo.ts remove",
    "demo:status": "node --env-file-if-exists=.env --import tsx src/scripts/demo.ts status",
    "demo:api-check": "node --env-file-if-exists=.env --import tsx scripts/demo-api-check.ts",
    "db:studio": "prisma studio",
    "secrets:generate": "tsx scripts/generate-secrets.ts",
    "openapi": "node --env-file-if-exists=.env --import tsx scripts/export-openapi.ts --check",
    "openapi:export": "node --env-file-if-exists=.env --import tsx scripts/export-openapi.ts",
    "jobs:run": "node --env-file-if-exists=.env --import tsx scripts/run-job.ts",
    "keys:reencrypt": "node --env-file-if-exists=.env --import tsx scripts/reencrypt-secrets.ts",
    "flow:e2e": "node --env-file-if-exists=.env --import tsx scripts/e2e-flow.ts",
    "preflight": "node --env-file-if-exists=.env --import tsx scripts/preflight.ts",
    "services:up": "docker compose up -d --wait redis",
    "postinstall": "prisma generate"
  }
}
