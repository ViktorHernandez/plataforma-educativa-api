NODE_ENV=development
APP_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
LOG_PRETTY=true
TRUST_PROXY=false
PUBLIC_API_URL=http://localhost:3000
WEB_APP_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
API_DOCS_ENABLED=true
METRICS_TOKEN=

DATABASE_URL=postgresql://postgres.your-project-ref:your-database-password@aws-0-your-region.pooler.supabase.com:6543/postgres
DIRECT_DATABASE_URL=postgresql://postgres.your-project-ref:your-database-password@aws-0-your-region.pooler.supabase.com:5432/postgres
DATABASE_SSL_MODE=require
DATABASE_SSL_CA_BASE64=
DATABASE_POOLER=auto
DATABASE_POOL_MAX=5
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_LOG_QUERIES=false

TEST_DATABASE_URL=postgresql://app:app_local_dev@localhost:5432/plataforma_test
TEST_DIRECT_DATABASE_URL=
TEST_DATABASE_ALLOW_RESET=false
TEST_DATABASE_SSL_MODE=auto
TEST_REDIS_URL=redis://localhost:6379/15

REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=pe:
REDIS_PROTOCOL=2
REDIS_COMMAND_TIMEOUT_MS=2000

JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=plataforma-educativa
JWT_SIGNING_KEYS=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
SESSION_IDLE_TIMEOUT_DAYS=14
REFRESH_REUSE_GRACE_SECONDS=10

ENCRYPTION_KEYS=
SECRETS_PEPPER=
KEY_ROTATION_BATCH_SIZE=200

COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict

PASSWORD_MIN_LENGTH=12
PASSWORD_BREACH_CHECK=false
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
REGISTRATION_ENABLED=true

MAIL_PROVIDER=console
MAIL_FROM=Plataforma Educativa <no-reply@example.com>
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

PUSH_FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY_BASE64=
PUSH_WEB_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
