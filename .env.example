WEB_PUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,push.services.mozilla.com,web.push.apple.com,*.push.apple.com,*.notify.windows.com

STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
FILE_URL_TTL_SECONDS=900

ANTIVIRUS_PROVIDER=disabled
FILE_SCAN_REQUIRED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=60000
ANTIVIRUS_MAX_SCAN_BYTES=209715200

PRIVACY_EXPORT_TTL_HOURS=168
PRIVACY_DELETION_GRACE_DAYS=14
REPORT_EXPORT_TTL_HOURS=72
AUDIT_RETENTION_DAYS=365
AUDIT_SECURITY_RETENTION_DAYS=1825
ACTIVITY_RETENTION_DAYS=730
NOTIFICATION_RETENTION_DAYS=365

OAUTH_REDIRECT_ALLOWLIST=
